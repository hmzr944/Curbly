# Public URL of the site, used for canonical URLs, the sitemap and the line added under reminders.
NEXT_PUBLIC_SITE_URL=https://hmzr944.github.io/Curbly
# Sub-path the site is served from ("" at a domain root, "/Curbly" on hmzr944.github.io/Curbly).
NEXT_PUBLIC_BASE_PATH=/Curbly
# Endpoint receiving early-access sign-ups as a JSON POST (Formspree, Tally, Make, Zapier, Google Apps Script…).
# Without it, the form is replaced by links to the free tools.
NEXT_PUBLIC_WAITLIST_URL=
