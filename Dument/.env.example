# Public URL of the site, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://dument.fr
# Where early-access sign-ups are forwarded (any endpoint accepting a JSON POST: Zapier, Make, n8n, Google Apps Script...).
# Without it, sign-ups are appended to data/waitlist.jsonl (local development only).
WAITLIST_WEBHOOK_URL=
