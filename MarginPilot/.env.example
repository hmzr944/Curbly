APP_NAME=MarginPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - Use SQLite for local development, PostgreSQL for production
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=marginpilot
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true   # Set to true in production — encrypts session data at rest
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@marginpilot.app"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_SALES_TEAM="contact@marginpilot.app"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# MarginPilot-specific Configuration
# ===========================================

# LLM Provider API Keys (encrypted in database, these are for direct testing)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# LLM Proxy Configuration
# Set to true to enable the LLM proxy middleware
LLM_PROXY_ENABLED=true

# Default cost estimation fallback (per 1K tokens)
LLM_DEFAULT_INPUT_COST=0.0010
LLM_DEFAULT_OUTPUT_COST=0.0020

# Policy enforcement defaults
POLICY_DEFAULT_MODE=enforce
POLICY_OBSERVE_ONLY=false

# Notification settings
NOTIFICATION_COOLDOWN_MINUTES=5
NOTIFICATION_MAX_RECIPIENTS=5

# Sanctum API Token settings
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,::1

# ===========================================
# Stripe Billing Configuration
# ===========================================

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe Dashboard > Products)
# AI Margin Scan - One-time €297
STRIPE_PRICE_SCAN=price_...
# Observe - €149/month
STRIPE_PRICE_OBSERVE=price_...
# Control - €349/month  
STRIPE_PRICE_CONTROL=price_...
# Scale - Custom pricing
STRIPE_PRICE_SCALE=price_...
