# Margexa — Production Environment Template
# Copy to .env and fill every value before deploying.
# Never commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="Margexa"
APP_ENV=production
APP_KEY=                        # php artisan key:generate
APP_DEBUG=false
APP_URL=https://app.margexa.io

# ─── Database ─────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=margexa_production
DB_USERNAME=margexa
DB_PASSWORD=                    # strong random password

# ─── Cache / Queue (Redis required in production) ────────────────────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=                 # set if Redis requires auth
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=                  # Postmark / SES API key
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@margexa.io
MAIL_FROM_NAME="Margexa"

# ─── Stripe (Margexa own billing) ────────────────────────────────────────────
STRIPE_KEY=pk_live_              # Publishable key
STRIPE_SECRET=sk_live_           # Secret key — keep safe
STRIPE_WEBHOOK_SECRET=whsec_    # From Stripe dashboard → Webhooks

# Stripe Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_TEAM=price_        # $200/mo Team plan
STRIPE_PRICE_BUSINESS=price_    # $800/mo Business plan
STRIPE_PRICE_ENTERPRISE=price_  # Custom Enterprise

# ─── LLM Provider Keys (encrypted per-org, but a default is needed) ──────────
# These are used when an org has not yet connected their own key.
OPENAI_API_KEY=sk-              # Optional default OpenAI key
ANTHROPIC_API_KEY=sk-ant-       # Optional default Anthropic key

# ─── Circuit Breaker / Rate Limiting ─────────────────────────────────────────
# Thresholds are defined in CircuitBreakerService constants.
# Redis cache driver is required for correct operation.

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning               # error | warning | info | debug
LOG_DEPRECATIONS_CHANNEL=null

# ─── Security ────────────────────────────────────────────────────────────────
SESSION_LIFETIME=120            # minutes
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.margexa.io

# ─── Horizon / Queue (if using Laravel Horizon) ───────────────────────────────
# HORIZON_ENVIRONMENT=production

# ─── Diagnostics (public entry-point — no secret needed) ─────────────────────
# The /api/diagnostic/* routes are public and throttled (20 req/min/IP).
